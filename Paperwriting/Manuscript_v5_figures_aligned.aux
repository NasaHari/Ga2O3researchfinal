\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Reverse electric-field magnitude in the planar JTE with field plate. Top: 0.25$\times $ and 2.00$\times $ nominal Mg dose at 0.15~$\mu $m JTE thickness. Bottom: 0.15 and 0.35~$\mu $m JTE thickness at nominal dose. Panel titles give the saved external anode voltages, not the blocking crossings. The semiconductor uses a shared 0--6~MV/cm linear scale, with values above 6~MV/cm shown in the top colour. Grey denotes Al$_2$O$_3$.}}{6}{figure.7}\protected@file@percent }
\newlabel{fig:fields}{{7}{6}{Reverse electric-field magnitude in the planar JTE with field plate. Top: 0.25$\times $ and 2.00$\times $ nominal Mg dose at 0.15~$\mu $m JTE thickness. Bottom: 0.15 and 0.35~$\mu $m JTE thickness at nominal dose. Panel titles give the saved external anode voltages, not the blocking crossings. The semiconductor uses a shared 0--6~MV/cm linear scale, with values above 6~MV/cm shown in the top colour. Grey denotes Al$_2$O$_3$}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Cutlines at $r=60~\mu $m: (a),(b) 0-V band diagrams versus Mg multiplier and termination thickness, with solid $E_C$ and dashed $E_V$ referenced to $E_F=0$; the curves overlap closely because the built-in band bending falls mainly in the lightly doped drift. (c),(d) Reverse drift-region field profiles at the final saved reverse-bias states, which need not be at the same voltage. In (b) and (d) the 0.08-$\mu $m curve is the 80-nm, 0.75-eV design point; it is not a member of the 1.10-eV thickness series, and differs in both thickness and input barrier. The annotated state voltages are the solver's final applied voltages.}}{6}{figure.8}\protected@file@percent }
\newlabel{fig:bands}{{8}{6}{Cutlines at $r=60~\mu $m: (a),(b) 0-V band diagrams versus Mg multiplier and termination thickness, with solid $E_C$ and dashed $E_V$ referenced to $E_F=0$; the curves overlap closely because the built-in band bending falls mainly in the lightly doped drift. (c),(d) Reverse drift-region field profiles at the final saved reverse-bias states, which need not be at the same voltage. In (b) and (d) the 0.08-$\mu $m curve is the 80-nm, 0.75-eV design point; it is not a member of the 1.10-eV thickness series, and differs in both thickness and input barrier. The annotated state voltages are the solver's final applied voltages}{figure.8}{}}
