\newlabel{fig:electrical}{{3}{3}{Architecture comparison at 298.15~K: (a) forward characteristics, (b) reverse characteristics with markers at the sustained 1~mA/cm$^2$ crossings, and (c) specific resistance from the forward fits over 200--300~A/cm$^2$. The field-plated and unplated curves can overlap}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Room-temperature reverse-current benchmark for the 105-$\mu $m bare diode. The triangle and square traces are digitized from Fig.~5 of Yang \emph  {et al.}~\cite  {Yang2017}; the square trace is shown only where it can be distinguished from overlapping curves. The dashed curve is the selected split-anode TCAD result. The dotted line marks $|J_R|=1$~mA/cm$^2$.}}{3}{figure.4}\protected@file@percent }
\newlabel{fig:bare_yang_benchmark}{{4}{3}{Room-temperature reverse-current benchmark for the 105-$\mu $m bare diode. The triangle and square traces are digitized from Fig.~5 of Yang \emph {et al.}~\cite {Yang2017}; the square trace is shown only where it can be distinguished from overlapping curves. The dashed curve is the selected split-anode TCAD result. The dotted line marks $|J_R|=1$~mA/cm$^2$}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Reverse electric-field magnitude in (a) the bare Schottky diode, (b) the planar JTE with field plate, (c) the mesa JBS with JTE and field plate, and (d) the trench JBS with JTE and field plate. Each panel shows its final saved reverse state at the indicated external anode bias, not a common-bias or current-threshold state. The shared semiconductor scale is 0--8~MV/cm, with values above 8~MV/cm saturated. Grey denotes Al$_2$O$_3$; lines identify the mesh contact boundaries.}}{4}{figure.5}\protected@file@percent }
\newlabel{fig:architecture_reverse_fields}{{5}{4}{Reverse electric-field magnitude in (a) the bare Schottky diode, (b) the planar JTE with field plate, (c) the mesa JBS with JTE and field plate, and (d) the trench JBS with JTE and field plate. Each panel shows its final saved reverse state at the indicated external anode bias, not a common-bias or current-threshold state. The shared semiconductor scale is 0--8~MV/cm, with values above 8~MV/cm saturated. Grey denotes Al$_2$O$_3$; lines identify the mesh contact boundaries}{figure.5}{}}
